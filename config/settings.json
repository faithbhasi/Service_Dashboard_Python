{
  "App": {
    "ProductName": "<PRODUCT_NAME>",
    "Environment": "<ENVIRONMENT_LABEL>",
    "DataDirectory": "<DATA_DIRECTORY>",
    "AssetDirectory": "<ASSET_DIRECTORY>",
    "BackupDirectory": "<BACKUP_DIRECTORY>",
    "BackupRetentionCount": 7,
    "DailyBackupEnabled": false,
    "BootstrapAdminOktaGroup": "<OKTA_ADMIN_GROUP>",
    "DashboardCacheMinutes": 5,
    "ExportRowLimit": 50000,
    "AuditRetentionDays": 365,
    "LogoMaxBytes": 524288,
    "SearchRateLimitPerMinute": 120,
    "WriteRateLimitPerMinute": 60
  },
  "Okta": {
    "Issuer": "<OKTA_ISSUER_URL>",
    "ClientId": "<OKTA_CLIENT_ID>",
    "ClientSecret": "<SET_VIA_SETTINGS_LOCAL_JSON_OR_ENVIRONMENT>",
    "GroupsClaim": "<OKTA_GROUPS_CLAIM>",
    "DevelopmentSignIn": false
  },
  "ActiveDirectory": {
    "Provider": "Ldap",
    "Domain": "<AD_DOMAIN_FQDN>",
    "Server": "<DC_FQDN>",
    "Port": 636,
    "UseLdaps": true,
    "BaseDn": "<AD_BASE_DN>",
    "VerifyCertificate": true
  },
  "Serilog": {
    "LogDirectory": "<LOG_DIRECTORY>"
  }
}
